From 079d54adfac79f691a96f09d7e267ef7595edae5 Mon Sep 17 00:00:00 2001
From: Jack Boykin <jtboykin.jb@gmail.com>
Date: Thu, 29 Oct 2026 14:29:29 -0500
Subject: [PATCH 2/2] avfilter/vf_crop: keep the configuration when a command
 fails

A rejected command left its expression and part of what it computed
behind. The filter then cropped later frames from the wrong spot, and
every later command failed on the stale expression.

Evaluate into locals and keep the old expression unless the whole
configuration is valid. A failed frame then leaves nothing stale, so
stop forcing a reconfiguration after it.

Fixes: d2b78fe6b7 ("libavfilter/vf_crop: implement process_command")
Signed-off-by: Jack Boykin <jtboykin.jb@gmail.com>
---
 libavfilter/vf_crop.c          | 100 ++++++++++++++++++---------------
 tests/fate/filter-video.mak    |   5 ++
 tests/filtergraphs/crop-cmd    |   3 +
 tests/ref/fate/filter-crop-cmd |  10 ++++
 4 files changed, 72 insertions(+), 46 deletions(-)
 create mode 100644 tests/filtergraphs/crop-cmd
 create mode 100644 tests/ref/fate/filter-crop-cmd

diff --git a/libavfilter/vf_crop.c b/libavfilter/vf_crop.c
index ba52ba780d..6f2da51603 100644
--- a/libavfilter/vf_crop.c
+++ b/libavfilter/vf_crop.c
@@ -35,6 +35,7 @@
 #include "libavutil/internal.h"
 #include "libavutil/imgutils.h"
 #include "libavutil/mathematics.h"
+#include "libavutil/mem.h"
 #include "libavutil/opt.h"
 
 static const char *const var_names[] = {
@@ -130,21 +131,24 @@ static int config_crop_area(AVFilterLink *link, int in_w, int in_h)
     AVFilterContext *ctx = link->dst;
     CropContext *s = ctx->priv;
     const AVPixFmtDescriptor *pix_desc = av_pix_fmt_desc_get(link->format);
-    int ret;
+    double var[VAR_VARS_NB];
+    AVRational sar;
+    int ret, w, h;
     const char *expr;
     double res;
 
-    s->var_values[VAR_IN_W]  = s->var_values[VAR_IW] = in_w;
-    s->var_values[VAR_IN_H]  = s->var_values[VAR_IH] = in_h;
-    s->var_values[VAR_A]     = (float) in_w / in_h;
-    s->var_values[VAR_SAR]   = link->sample_aspect_ratio.num ? av_q2d(link->sample_aspect_ratio) : 1;
-    s->var_values[VAR_DAR]   = s->var_values[VAR_A] * s->var_values[VAR_SAR];
-    s->var_values[VAR_HSUB]  = 1<<pix_desc->log2_chroma_w;
-    s->var_values[VAR_VSUB]  = 1<<pix_desc->log2_chroma_h;
-    s->var_values[VAR_OUT_W] = s->var_values[VAR_OW] = NAN;
-    s->var_values[VAR_OUT_H] = s->var_values[VAR_OH] = NAN;
-    s->var_values[VAR_N]     = 0;
-    s->var_values[VAR_T]     = NAN;
+    memcpy(var, s->var_values, sizeof(var));
+    var[VAR_IN_W]  = var[VAR_IW] = in_w;
+    var[VAR_IN_H]  = var[VAR_IH] = in_h;
+    var[VAR_A]     = (float) in_w / in_h;
+    var[VAR_SAR]   = link->sample_aspect_ratio.num ? av_q2d(link->sample_aspect_ratio) : 1;
+    var[VAR_DAR]   = var[VAR_A] * var[VAR_SAR];
+    var[VAR_HSUB]  = 1<<pix_desc->log2_chroma_w;
+    var[VAR_VSUB]  = 1<<pix_desc->log2_chroma_h;
+    var[VAR_OUT_W] = var[VAR_OW] = NAN;
+    var[VAR_OUT_H] = var[VAR_OH] = NAN;
+    var[VAR_N]     = 0;
+    var[VAR_T]     = NAN;
 
     av_image_fill_max_pixsteps(s->max_step, NULL, pix_desc);
 
@@ -157,23 +161,23 @@ static int config_crop_area(AVFilterLink *link, int in_w, int in_h)
     }
 
     av_expr_parse_and_eval(&res, (expr = s->w_expr),
-                           var_names, s->var_values,
+                           var_names, var,
                            NULL, NULL, NULL, NULL, NULL, 0, ctx);
-    s->var_values[VAR_OUT_W] = s->var_values[VAR_OW] = res;
+    var[VAR_OUT_W] = var[VAR_OW] = res;
     if ((ret = av_expr_parse_and_eval(&res, (expr = s->h_expr),
-                                      var_names, s->var_values,
+                                      var_names, var,
                                       NULL, NULL, NULL, NULL, NULL, 0, ctx)) < 0)
         goto fail_expr;
-    s->var_values[VAR_OUT_H] = s->var_values[VAR_OH] = res;
+    var[VAR_OUT_H] = var[VAR_OH] = res;
     /* evaluate again ow as it may depend on oh */
     if ((ret = av_expr_parse_and_eval(&res, (expr = s->w_expr),
-                                      var_names, s->var_values,
+                                      var_names, var,
                                       NULL, NULL, NULL, NULL, NULL, 0, ctx)) < 0)
         goto fail_expr;
 
-    s->var_values[VAR_OUT_W] = s->var_values[VAR_OW] = res;
-    if (normalize_double(&s->w, s->var_values[VAR_OUT_W]) < 0 ||
-        normalize_double(&s->h, s->var_values[VAR_OUT_H]) < 0) {
+    var[VAR_OUT_W] = var[VAR_OW] = res;
+    if (normalize_double(&w, var[VAR_OUT_W]) < 0 ||
+        normalize_double(&h, var[VAR_OUT_H]) < 0) {
         av_log(ctx, AV_LOG_ERROR,
                "Too big value or invalid expression for out_w/ow or out_h/oh. "
                "Maybe the expression for out_w:'%s' or for out_h:'%s' is self-referencing.\n",
@@ -182,30 +186,35 @@ static int config_crop_area(AVFilterLink *link, int in_w, int in_h)
     }
 
     if (!s->exact) {
-        s->w &= ~((1 << s->hsub) - 1);
-        s->h &= ~((1 << s->vsub) - 1);
+        w &= ~((1 << s->hsub) - 1);
+        h &= ~((1 << s->vsub) - 1);
     }
 
     if (s->keep_aspect) {
         AVRational dar = av_mul_q(link->sample_aspect_ratio,
                                   (AVRational){ in_w, in_h });
-        av_reduce(&s->out_sar.num, &s->out_sar.den,
-                  (int64_t)dar.num * s->h, (int64_t)dar.den * s->w, INT_MAX);
+        av_reduce(&sar.num, &sar.den,
+                  (int64_t)dar.num * h, (int64_t)dar.den * w, INT_MAX);
     } else
-        s->out_sar = link->sample_aspect_ratio;
+        sar = link->sample_aspect_ratio;
 
     av_log(ctx, AV_LOG_VERBOSE, "w:%d h:%d sar:%d/%d -> w:%d h:%d sar:%d/%d\n",
            in_w, in_h, link->sample_aspect_ratio.num, link->sample_aspect_ratio.den,
-           s->w, s->h, s->out_sar.num, s->out_sar.den);
+           w, h, sar.num, sar.den);
 
-    if (s->w <= 0 || s->h <= 0 ||
-        s->w > in_w || s->h > in_h) {
+    if (w <= 0 || h <= 0 ||
+        w > in_w || h > in_h) {
         av_log(ctx, AV_LOG_ERROR,
                "Invalid too big or non positive size for width '%d' or height '%d'\n",
-               s->w, s->h);
+               w, h);
         return AVERROR(EINVAL);
     }
 
+    memcpy(s->var_values, var, sizeof(var));
+    s->w = w;
+    s->h = h;
+    s->out_sar = sar;
+
     /* set default, required in the case the first computed value for x/y is NAN */
     s->x = (in_w - s->w) / 2;
     s->y = (in_h - s->h) / 2;
@@ -226,9 +235,8 @@ static int config_exprs(AVFilterLink *link, int in_w, int in_h)
 {
     CropContext *s = link->dst->priv;
     AVExpr *x_pexpr = NULL, *y_pexpr = NULL;
+    int ret;
 
-    s->var_values[VAR_X] = NAN;
-    s->var_values[VAR_Y] = NAN;
     if (av_expr_parse(&x_pexpr, s->x_expr, var_names,
                       NULL, NULL, NULL, NULL, 0, link->dst) < 0 ||
         av_expr_parse(&y_pexpr, s->y_expr, var_names,
@@ -236,12 +244,19 @@ static int config_exprs(AVFilterLink *link, int in_w, int in_h)
         av_expr_free(x_pexpr);
         return AVERROR(EINVAL);
     }
+    if ((ret = config_crop_area(link, in_w, in_h)) < 0) {
+        av_expr_free(x_pexpr);
+        av_expr_free(y_pexpr);
+        return ret;
+    }
     av_expr_free(s->x_pexpr);
     av_expr_free(s->y_pexpr);
     s->x_pexpr = x_pexpr;
     s->y_pexpr = y_pexpr;
+    s->var_values[VAR_X] = NAN;
+    s->var_values[VAR_Y] = NAN;
 
-    return config_crop_area(link, in_w, in_h);
+    return 0;
 }
 
 static int config_input(AVFilterLink *link)
@@ -285,7 +300,6 @@ static int filter_frame(AVFilterLink *link, AVFrame *frame)
         link->h = frame->height;
         if ((ret = config_crop_area(link, in_w, in_h)) < 0 ||
             (ret = config_output(ctx->outputs[0])) < 0) {
-            s->in_w = -1;
             av_frame_free(&frame);
             return ret;
         }
@@ -360,25 +374,19 @@ static int process_command(AVFilterContext *ctx, const char *cmd, const char *ar
         || !strcmp(cmd, "out_h")  || !strcmp(cmd, "h")
         || !strcmp(cmd, "x")      || !strcmp(cmd, "y")) {
 
-        int old_x = s->x;
-        int old_y = s->y;
-        int old_w = s->w;
-        int old_h = s->h;
-
         AVFilterLink *outlink = ctx->outputs[0];
         AVFilterLink *inlink  = ctx->inputs[0];
-        int in_w = s->var_values[VAR_IN_W];
-        int in_h = s->var_values[VAR_IN_H];
+        uint8_t *old;
 
+        if ((ret = av_opt_get(s, cmd, 0, &old)) < 0)
+            return ret;
         av_opt_set(s, cmd, args, 0);
 
-        if ((ret = config_exprs(inlink, in_w, in_h)) < 0) {
-            s->x = old_x;
-            s->y = old_y;
-            s->w = old_w;
-            s->h = old_h;
+        if ((ret = config_exprs(inlink, s->in_w, s->in_h)) < 0)
+            av_opt_set(s, cmd, old, 0);
+        av_free(old);
+        if (ret < 0)
             return ret;
-        }
 
         ret = config_output(outlink);
 
diff --git a/tests/fate/filter-video.mak b/tests/fate/filter-video.mak
index 7769d04959..28421e5d55 100644
--- a/tests/fate/filter-video.mak
+++ b/tests/fate/filter-video.mak
